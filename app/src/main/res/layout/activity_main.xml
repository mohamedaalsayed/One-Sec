<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="one sec"
            android:textColor="@color/text_primary"
            android:textSize="32sp"
            android:letterSpacing="0.05"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="pause before you scroll"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-light" />

        <!-- Stats bar -->
        <TextView
            android:id="@+id/tvStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text=""
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:fontFamily="sans-serif-light" />

        <!-- Permission cards -->
        <LinearLayout
            android:id="@+id/layoutPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnAccessibility"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_enable_service"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnOverlay"
                style="@style/Btn.Ghost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/btn_enable_overlay"/>

        </LinearLayout>

        <!-- Quick check length -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/quick_check_setting_label"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium" />

        <!-- Filled with one chip per allowed length in MainActivity -->
        <LinearLayout
            android:id="@+id/layoutQuickCheckMinutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <!-- Things to do instead, suggested before a scroll session -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="@string/alternatives_setting_label"
            android:textColor="@color/text_hint"
            android:textSize="10sp"
            android:letterSpacing="0.15"
            android:fontFamily="sans-serif-medium" />

        <!-- Filled in MainActivity; tap one to remove it -->
        <LinearLayout
            android:id="@+id/layoutAlternatives"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etAlternative"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:hint="@string/alternatives_hint"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAddAlternative"
                style="@style/Btn.Ghost"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="0dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingHorizontal="16dp"
                android:text="@string/btn_add_alternative"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1A1A1A"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"/>

        <!-- Apps list label -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GUARDED APPS"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnAddApp"
                style="@style/Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:paddingHorizontal="16dp"
                android:minHeight="0dp"
                android:text="+ Add"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Empty state -->
        <TextView
            android:id="@+id/tvNoApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/no_apps_hint"
            android:textColor="@color/text_hint"
            android:textSize="14sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.6"
            android:visibility="visible" />

        <!-- Guarded apps list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerApps"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:visibility="gone" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
