<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- PHASE 1: Breathing exercise -->
    <LinearLayout
        android:id="@+id/layoutBreathe"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="40dp"
        android:visibility="visible">

        <!-- App icon + name -->
        <LinearLayout
            android:id="@+id/layoutAppInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="60dp">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light"
                android:letterSpacing="0.05" />

        </LinearLayout>

        <!-- Animated breath ring -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal">

            <!-- Outer pulsing ring -->
            <ImageView
                android:id="@+id/ivBreathRingOuter"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:src="@drawable/breath_circle"
                android:alpha="0.3" />

            <!-- Middle ring -->
            <ImageView
                android:id="@+id/ivBreathRingMid"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:src="@drawable/breath_circle"
                android:alpha="0.5" />

            <!-- Inner circle (fills/contracts) -->
            <ImageView
                android:id="@+id/ivBreathCore"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:src="@drawable/breath_circle"
                android:alpha="1.0" />

            <!-- Countdown number -->
            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="36sp"
                android:fontFamily="sans-serif-light"
                android:text="5" />

        </FrameLayout>

        <!-- Breathe instruction -->
        <TextView
            android:id="@+id/tvBreatheLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="breathe in"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.06" />

    </LinearLayout>

    <!-- PHASE 2: Decision screen -->
    <LinearLayout
        android:id="@+id/layoutDecide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingHorizontal="28dp"
        android:visibility="gone">

        <!-- Attempt count, or the app a link came from -->
        <TextView
            android:id="@+id/tvDecideTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.06"
            android:text="3 times today" />

        <TextView
            android:id="@+id/tvTitleTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/pause_title_top"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light" />

        <TextView
            android:id="@+id/tvTitleBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:text="@string/pause_title_bottom"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:fontFamily="sans-serif-light" />

        <!-- Reason chips (normal pause only) -->
        <LinearLayout
            android:id="@+id/layoutReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="WHY?"
                android:textColor="@color/text_hint"
                android:textSize="10sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/chipBored"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Bored"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipHabit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Just habit"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipEscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Escape"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="48dp">

                <TextView
                    android:id="@+id/chipProcrastinate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Procrastinating"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipIntentional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Intentional"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- Quick check, from the 5th of the day: say what you're checking -->
        <EditText
            android:id="@+id/etQuickReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:hint="@string/quick_reason_hint"
            android:inputType="textCapSentences"
            android:maxLines="1"
            android:importantForAutofill="no"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- Scroll confirmation: one button per thing to do instead -->
        <LinearLayout
            android:id="@+id/layoutAlternativeButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- Action buttons -->
        <Button
            android:id="@+id/btnPrimary"
            style="@style/Btn.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_go_back"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnSecondary"
            style="@style/Btn.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_open_anyway" />

        <Button
            android:id="@+id/btnTertiary"
            style="@style/Btn.Ghost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
