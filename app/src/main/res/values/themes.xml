<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.OneSec" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/bg_card</item>
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Theme.OneSec.Overlay" parent="Theme.OneSec">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@style/SlideUpAnimation</item>
    </style>

    <style name="SlideUpAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/slide_up</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_down</item>
    </style>

    <style name="Btn.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/bg</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Btn.Ghost" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="strokeColor">@color/bg_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Btn.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/danger</item>
        <item name="strokeColor">@color/danger</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
</resources>
